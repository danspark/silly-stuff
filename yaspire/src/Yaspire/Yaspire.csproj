<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yaspire</ToolCommandName>
    <PackageId>yaspire</PackageId>
    <Version>0.1.0</Version>
    <Authors>Daniel Reis</Authors>
    <Description>.NET Yaspire: write Aspire AppHosts in YAML and drive them with the Aspire CLI.</Description>
    <PackageTags>aspire;yaml;apphost;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/danspark/silly-stuff</PackageProjectUrl>
    <RepositoryUrl>https://github.com/danspark/silly-stuff</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
